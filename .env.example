# GENERATED by `pnpm env:example` from packages/config/src/env.ts. Do not edit by hand.
# SECRET = never commit a value, never log it, never put it in a NEXT_PUBLIC_ variable.

# production for builds and images.
# not secret; optional; used by: web
NODE_ENV=production

# Set by Next.js itself (nodejs | edge); read by instrumentation. Do not set.
# not secret; optional; used by: web
NEXT_RUNTIME=

# Supabase API URL the browser and the server use (public by design).
# not secret; required by: web; used by: web
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable (anon) key; public by design, RLS protects data.
# not secret; required by: web; used by: web
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Fallback origin for sign-up confirmation links.
# not secret; optional; used by: web
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL of the web app (pay/opt-out links, CSRF origin). https in production.
# not secret; required by: web; used by: web, worker
PUBLIC_APP_URL=http://localhost:3000

# Public base URL of the webhook runtime, if different from PUBLIC_APP_URL.
# not secret; optional; used by: web
WEBHOOKS_PUBLIC_URL=https://hooks.example.com

# Supabase API URL for server-side code.
# not secret; required by: web; used by: web, worker, cli, test
SUPABASE_URL=http://127.0.0.1:54321

# Service-role key: server only (Storage signed URLs, staging the API import). Never NEXT_PUBLIC_.
# SECRET; required by: web; used by: web, worker, cli, test
SUPABASE_SERVICE_ROLE_KEY=

# Alternative name for the server key (newer Supabase key format).
# SECRET; optional; used by: web
SUPABASE_SECRET_KEY=

# Direct Postgres URL for the web server trusted pipelines (contains the password).
# SECRET; required by: web; used by: web, cli, test
SUPABASE_DB_URL=

# Fallback for SUPABASE_DB_URL in the web server.
# SECRET; optional; used by: web
DATABASE_URL=

# Direct Postgres URL for the worker, processor, webhook runtime and CLIs. Without it they use the LOCAL stack.
# SECRET; required by: worker, webhooks, processor; used by: worker, webhooks, processor, cli, demo
WORKER_DATABASE_URL=

# Local anon key for integration tests (read from `supabase status` when unset).
# not secret; optional; used by: test
SUPABASE_ANON_KEY=

# Default SMTP host (a tenant account can override when SMTP_ALLOW_TENANT_HOST=true).
# not secret; optional; used by: worker, web
SMTP_HOST=127.0.0.1

# Default SMTP port.
# not secret; optional; used by: worker, web
SMTP_PORT=54325

# true for implicit TLS.
# not secret; optional; used by: worker, web
SMTP_SECURE=false

# Default SMTP user (the password lives in Vault per tenant).
# not secret; optional; used by: worker, web
SMTP_USER=

# Let tenant channel config choose the SMTP host.
# not secret; optional; used by: worker, web
SMTP_ALLOW_TENANT_HOST=false

# Meta Graph API version; unset = no WhatsApp sending.
# not secret; optional; used by: worker, web
WHATSAPP_GRAPH_VERSION=

# Meta app secret for webhook signatures; unset = WhatsApp webhook disabled.
# SECRET; optional; used by: webhooks
WHATSAPP_APP_SECRET=

# Meta webhook verification token.
# SECRET; optional; used by: webhooks
WHATSAPP_VERIFY_TOKEN=

# true = serve /webhooks/payments/<token>.
# not secret; optional; used by: webhooks
PAYMENTS_WEBHOOKS=true

# TESTS AND DEMO ONLY: enables the FakeGateway for test-mode accounts. Never set in production.
# not secret; optional; used by: worker, web, webhooks, demo, test
PAYMENTS_ALLOW_FAKE=false

# How many trusted proxies append X-Forwarded-For (0 = do not trust it).
# not secret; optional; used by: web
TRUST_PROXY_HOPS=0

# Webhook runtime port.
# not secret; optional; used by: webhooks
PORT=8787

# anthropic = classify replies with the model; unset = every reply becomes a human task.
# not secret; optional; used by: processor
CLASSIFIER=

# Model id when CLASSIFIER=anthropic.
# not secret; optional; used by: processor
CLASSIFIER_MODEL=

# Classifier call timeout.
# not secret; optional; used by: processor
CLASSIFIER_TIMEOUT_MS=30000

# false = no model fallback.
# not secret; optional; used by: processor
CLASSIFIER_FALLBACKS=true

# Read by the Anthropic SDK when the classifier or proof extraction is enabled.
# SECRET; optional; used by: processor, worker, smoke
ANTHROPIC_API_KEY=

# anthropic = AI hints on proof images (tenants must also opt in).
# not secret; optional; used by: worker
PROOF_EXTRACTION=

# Model id for proof hints.
# not secret; optional; used by: worker
PROOF_EXTRACTION_MODEL=

# false = no model fallback.
# not secret; optional; used by: worker
PROOF_EXTRACTION_FALLBACKS=true

# Build folder (the e2e build uses .next-e2e).
# not secret; optional; used by: test
NEXT_DIST_DIR=

# Reserved: no error-reporting vendor is wired (ErrorReporter is a no-op by default).
# SECRET; optional; used by: nobody yet
SENTRY_DSN=

# Watchdog: a heartbeat older than this is stale.
# not secret; optional; used by: cli
ALERT_STALE_SECONDS=300

# Watchdog: where system findings are emailed (SMTP defaults). Unset = exit code and JSON only.
# not secret; optional; used by: cli
OPS_ALERT_EMAIL=

# Watchdog: sender address for ops alerts.
# not secret; optional; used by: cli
OPS_ALERT_FROM=

# Build-time only: `standalone` makes next build emit the traced server the web image runs (set by the Dockerfile).
# not secret; optional; used by: web
NEXT_OUTPUT=

# Which service a services-image container runs (worker | processor | webhooks); picks the container healthcheck.
# not secret; optional; used by: worker, webhooks, processor
DUELOOP_SERVICE=worker

# Container healthcheck: a heartbeat older than this many seconds is unhealthy (default 300).
# not secret; optional; used by: worker, processor
HEALTH_MAX_AGE=300

# pnpm demo: port of the demo web app (default 3000).
# not secret; optional; used by: demo
DEMO_WEB_PORT=3000

# pnpm demo: port of the demo webhooks service (default 8787).
# not secret; optional; used by: demo
DEMO_WEBHOOKS_PORT=8787

# Set to 1 by pnpm demo:record: the e2e demo records video and keeps page DOMs for the leak check.
# not secret; optional; used by: demo, test
DEMO_RECORD=

# Set by pnpm demo:record: where the e2e demo writes the page DOMs it showed.
# not secret; optional; used by: demo, test
DEMO_RECORD_DOM=

# Set by `pnpm demo` only; demo:control refuses without it.
# not secret; optional; used by: demo
DEMO_MODE=

# Demo clock passed to child processes.
# not secret; optional; used by: demo
DEMO_NOW=

# Demo/script clock.
# not secret; optional; used by: demo
NOW_ISO=

# Tenant for scripts.
# not secret; optional; used by: demo, smoke
TENANT_ID=

# Test harness log file.
# not secret; optional; used by: test
SEND_LOG=

# Test harness log file.
# not secret; optional; used by: test
APPLY_LOG=

# Local mail catcher API.
# not secret; optional; used by: demo, test
MAILPIT_URL=http://127.0.0.1:54324

# Smoke test target.
# not secret; optional; used by: smoke
WEBHOOK_URL=

# 1 = run the live webhook smoke test.
# not secret; optional; used by: smoke
WEBHOOK_SMOKE=

# 1 = run the live WhatsApp smoke test.
# not secret; optional; used by: smoke
WHATSAPP_SMOKE=

# WhatsApp smoke test access token.
# SECRET; optional; used by: smoke
WHATSAPP_TOKEN=

# WhatsApp smoke test sender.
# not secret; optional; used by: smoke
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp smoke recipient (E.164).
# not secret; optional; used by: smoke
WHATSAPP_SMOKE_TO=

# Approved template for the smoke test.
# not secret; optional; used by: smoke
WHATSAPP_SMOKE_TEMPLATE=

# Template language for the smoke test.
# not secret; optional; used by: smoke
WHATSAPP_SMOKE_LANGUAGE=

# 1 = run the Stripe test-mode smoke test.
# not secret; optional; used by: smoke
STRIPE_SMOKE=

# Stripe TEST-mode restricted key for the smoke test (never live).
# SECRET; optional; used by: smoke
STRIPE_TEST_API_KEY=

# 1 = run the paid live classifier evaluation.
# not secret; optional; used by: smoke
EVAL_LIVE=

# 1 = run the paid live proof evaluation.
# not secret; optional; used by: smoke
PROOF_EVAL=

# Folder of labelled proof images for the live evaluation.
# not secret; optional; used by: smoke
PROOF_EVAL_DIR=
