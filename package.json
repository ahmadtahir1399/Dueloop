{
  "name": "dueloop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dueloop/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "sim": "node packages/sim/src/cli.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db && vitest run --config vitest.db.config.ts",
    "db:rls-check": "node packages/db/scripts/rls-check.ts",
    "db:types": "node packages/db/scripts/db-types.ts write",
    "db:types:check": "node packages/db/scripts/db-types.ts check",
    "chaos": "vitest run --config vitest.db.config.ts packages/worker/test-db/chaos.test.ts packages/worker/test-db/gates.test.ts packages/inbound/test-db/chaos.test.ts packages/worker/test-db/payments-chaos.test.ts",
    "worker": "node packages/worker/src/bin/worker.ts",
    "approvals": "node packages/worker/src/bin/approvals.ts",
    "messages": "node packages/worker/src/bin/messages.ts",
    "tenant": "node packages/worker/src/bin/tenant.ts",
    "tasks": "node packages/worker/src/bin/tasks.ts",
    "promises": "node packages/worker/src/bin/promises.ts",
    "payments": "node packages/worker/src/bin/payments.ts",
    "payments:integrity": "node packages/worker/src/bin/payments.ts integrity",
    "proofs": "node packages/worker/src/bin/proofs.ts",
    "inbound": "node packages/worker/src/bin/inbound.ts",
    "webhooks": "node packages/webhooks/src/bin/webhooks.ts",
    "demo:send": "node packages/worker/scripts/demo-send.ts",
    "demo:replies": "node packages/worker/scripts/demo-replies.ts",
    "demo:payments": "node packages/worker/scripts/demo-payments.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:adversarial": "vitest run --config vitest.adversarial.config.ts",
    "classifier:eval": "node packages/classifier/eval/eval.ts",
    "classifier:record": "node packages/classifier/eval/record.ts",
    "eval:live": "node packages/classifier/eval/record.ts --classifier anthropic",
    "smoke:whatsapp": "node packages/adapters-whatsapp/scripts/smoke.ts",
    "smoke:whatsapp-webhook": "node packages/webhooks/scripts/smoke.ts",
    "smoke:stripe": "node packages/adapters-payments/scripts/smoke-stripe.ts",
    "eval:proof-live": "node packages/proofs/eval/live.ts",
    "import": "node packages/ingest/src/cli.ts",
    "import:twice": "node packages/ingest/scripts/import-twice-check.ts",
    "web:build": "pnpm --filter @dueloop/web build",
    "web:test:e2e": "pnpm --filter @dueloop/web exec playwright test --project e2e",
    "web:test:security": "pnpm --filter @dueloop/web exec playwright test --project security",
    "web:test:a11y": "pnpm --filter @dueloop/web exec playwright test --project a11y",
    "web:test:lowbandwidth": "pnpm --filter @dueloop/web exec playwright test --project lowbandwidth",
    "e2e:demo": "pnpm --filter @dueloop/web exec playwright test --project demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "pg": "8.23.1",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
